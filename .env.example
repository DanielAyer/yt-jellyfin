# Copy this file to .env and fill in the values for your environment.
# Real environment variables (e.g. systemd Environment= lines) always
# take priority over .env if both are set.

# REQUIRED — root folder where downloaded videos are stored, organized as
# LIBRARY_ROOT/<ChannelName>/video files
LIBRARY_ROOT=

# REQUIRED — path to the SQLite database file. A common choice is a hidden
# file inside LIBRARY_ROOT so it travels with the drive, e.g.
# /path/to/your/library/.ytjf.db
DB_PATH=

# OPTIONAL — host/port the Flask app binds to (defaults shown)
HOST=0.0.0.0
PORT=5000
