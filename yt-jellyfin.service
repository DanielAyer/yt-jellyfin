[Unit]
Description=YouTube → Jellyfin Sync Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jellyfin
WorkingDirectory=/opt/yt-jellyfin
ExecStart=/opt/yt-jellyfin/venv/bin/python app.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# REQUIRED — set these to your environment, or remove this block entirely
# and use a .env file in the working directory instead (copy .env.example
# to .env and fill it in).
Environment=LIBRARY_ROOT=/path/to/your/library
Environment=DB_PATH=/path/to/your/library/.ytjf.db
# Environment=PORT=5000

[Install]
WantedBy=multi-user.target
