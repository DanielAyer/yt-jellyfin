[Unit]
Description=YouTube → Jellyfin Sync Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jellyfin
WorkingDirectory=/opt/yt-jellyfin
ExecStart=/opt/yt-jellyfin/venv/bin/python app.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# Configuration is read from .env in the working directory.
# Run the app and complete the setup wizard to generate .env automatically.
# Optional: override specific values here, e.g.:
# Environment=PORT=5000

[Install]
WantedBy=multi-user.target
